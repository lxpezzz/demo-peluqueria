---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { MoveHorizontal } from 'lucide-astro';

interface Props {
	id: string;
	beforeImage: ImageMetadata;
	beforeAlt: string;
	afterImage: ImageMetadata;
	afterAlt: string;
	label: string;
	initialPosition?: number;
	aspectRatio?: string;
	priority?: boolean;
	demoNote?: string;
}

const {
	id,
	beforeImage,
	beforeAlt,
	afterImage,
	afterAlt,
	label,
	initialPosition = 50,
	aspectRatio = '3 / 4',
	priority = false,
	demoNote = 'Estudio visual de demostración',
} = Astro.props;
---

<div class="ba-wrapper">
	<div
		class="ba-slider"
		id={`slider-${id}`}
		data-ba-slider
		style={`--ba-pos: ${initialPosition}%; --ba-ratio: ${aspectRatio};`}
	>
		<div class="ba-slider__stage" data-ba-stage>
			{/* Base layer: DESPUÉS (right side) */}
			<div class="ba-slider__layer ba-slider__layer--after">
				<Image
					src={afterImage}
					alt={afterAlt}
					widths={[480, 760, 1080]}
					sizes="(max-width: 768px) 100vw, 52vw"
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : undefined}
					class="ba-slider__image"
					draggable="false"
				/>
			</div>

			{/* Clipped top layer: ANTES (left side) */}
			<div class="ba-slider__layer ba-slider__layer--before">
				<Image
					src={beforeImage}
					alt={beforeAlt}
					widths={[480, 760, 1080]}
					sizes="(max-width: 768px) 100vw, 52vw"
					loading={priority ? 'eager' : 'lazy'}
					class="ba-slider__image"
					draggable="false"
				/>
			</div>

			{/* Labels */}
			<span class="ba-slider__tag ba-slider__tag--before" data-ba-tag-before>
				Antes
			</span>
			<span class="ba-slider__tag ba-slider__tag--after" data-ba-tag-after>
				Después
			</span>

			{/* Divider + interactive handle */}
			<div class="ba-slider__divider" aria-hidden="true"></div>
			<button
				type="button"
				class="ba-slider__handle"
				role="slider"
				aria-label={`Comparar antes y después: ${label}`}
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow={initialPosition}
				aria-valuetext={`${initialPosition}% antes, ${100 - initialPosition}% después`}
				data-ba-handle
			>
				<span class="ba-slider__handle-circle" aria-hidden="true">
					<MoveHorizontal size={16} stroke-width={1.35} />
				</span>
			</button>
		</div>
	</div>

	<div class="ba-wrapper__foot">
		<span class="ba-wrapper__hint">Desliza o usa las flechas del teclado para comparar</span>
		<span class="ba-wrapper__demo">{demoNote}</span>
	</div>

	<noscript>
		<div class="ba-fallback">
			<figure class="ba-fallback__item">
				<figcaption>Antes</figcaption>
				<Image src={beforeImage} alt={beforeAlt} widths={[480, 760]} loading="lazy" />
			</figure>
			<figure class="ba-fallback__item">
				<figcaption>Después</figcaption>
				<Image src={afterImage} alt={afterAlt} widths={[480, 760]} loading="lazy" />
			</figure>
		</div>
	</noscript>
</div>

<style>
	.ba-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		width: 100%;
	}

	.ba-slider {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ba-ratio, 3 / 4);
		overflow: hidden;
		background-color: #191817;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}

	.ba-slider__stage {
		position: relative;
		width: 100%;
		height: 100%;
		cursor: ew-resize;
	}

	.ba-slider__layer {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.ba-slider__layer--before {
		clip-path: inset(0 calc(100% - var(--ba-pos, 50%)) 0 0);
	}

	.ba-slider__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 22%;
		pointer-events: none;
	}

	.ba-slider__tag {
		position: absolute;
		top: 1.15rem;
		z-index: 3;
		padding: 0.35rem 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-paper);
		background-color: rgba(34, 33, 32, 0.74);
		border: 1px solid rgba(248, 247, 244, 0.2);
		pointer-events: none;
		transition: opacity var(--duration-fast) var(--ease-editorial);
	}

	.ba-slider__tag--before {
		left: 1.15rem;
	}

	.ba-slider__tag--after {
		right: 1.15rem;
	}

	.ba-slider__tag.is-dimmed {
		opacity: 0;
	}

	.ba-slider__divider {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--ba-pos, 50%);
		width: 1px;
		background-color: rgba(248, 247, 244, 0.88);
		transform: translateX(-0.5px);
		z-index: 4;
		pointer-events: none;
	}

	.ba-slider__handle {
		position: absolute;
		top: 50%;
		left: var(--ba-pos, 50%);
		transform: translate(-50%, -50%);
		z-index: 5;
		width: 3.25rem;
		height: 3.25rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: ew-resize;
	}

	.ba-slider__handle-circle {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background-color: rgba(34, 33, 32, 0.82);
		color: var(--color-paper);
		border: 1px solid rgba(248, 247, 244, 0.68);
		transition:
			background-color var(--duration-fast) var(--ease-editorial),
			color var(--duration-fast) var(--ease-editorial),
			transform var(--duration-fast) var(--ease-editorial),
			border-color var(--duration-fast) var(--ease-editorial);
	}

	.ba-slider__handle:hover .ba-slider__handle-circle,
	.ba-slider__handle:focus-visible .ba-slider__handle-circle,
	.ba-slider.is-dragging .ba-slider__handle-circle {
		background-color: var(--color-ivory);
		color: var(--color-charcoal);
		border-color: var(--color-ivory);
		transform: scale(1.06);
	}

	.ba-slider__handle:focus-visible {
		outline: none;
	}

	.ba-slider__handle:focus-visible .ba-slider__handle-circle {
		box-shadow: 0 0 0 2px var(--color-charcoal), 0 0 0 4px var(--color-terracotta);
	}

	.ba-wrapper__foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	[data-theme='dark'] .ba-wrapper__foot {
		color: var(--color-stone);
	}

	.ba-wrapper__demo {
		opacity: 0.82;
	}

	.ba-fallback {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1rem;
	}

	.ba-fallback__item {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: var(--text-label);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	@media (max-width: 520px) {
		.ba-slider__tag {
			top: 0.85rem;
			padding: 0.3rem 0.55rem;
		}

		.ba-slider__tag--before {
			left: 0.85rem;
		}

		.ba-slider__tag--after {
			right: 0.85rem;
		}
	}
</style>

<script>
	const initBeforeAfterSliders = () => {
		const sliders = document.querySelectorAll<HTMLElement>('[data-ba-slider]');

		sliders.forEach((slider) => {
			if (slider.dataset.baInitialized === 'true') return;
			slider.dataset.baInitialized = 'true';

			const stage = slider.querySelector<HTMLElement>('[data-ba-stage]');
			const handle = slider.querySelector<HTMLButtonElement>('[data-ba-handle]');
			const tagBefore = slider.querySelector<HTMLElement>('[data-ba-tag-before]');
			const tagAfter = slider.querySelector<HTMLElement>('[data-ba-tag-after]');
			if (!stage || !handle) return;

			let current = Number(handle.getAttribute('aria-valuenow') ?? 50);
			let dragging = false;
			let cachedRect: DOMRect | null = null;
			let frameId = 0;

			const clamp = (val: number) => Math.max(0, Math.min(100, val));

			const applyPosition = (percent: number) => {
				current = clamp(percent);
				const rounded = Math.round(current);
				slider.style.setProperty('--ba-pos', `${current.toFixed(2)}%`);
				handle.setAttribute('aria-valuenow', String(rounded));
				handle.setAttribute(
					'aria-valuetext',
					`${rounded}% antes, ${100 - rounded}% después`,
				);
				tagBefore?.classList.toggle('is-dimmed', current < 16);
				tagAfter?.classList.toggle('is-dimmed', current > 84);
			};

			const updateFromClientX = (clientX: number) => {
				const rect = cachedRect ?? stage.getBoundingClientRect();
				if (rect.width <= 0) return;
				const next = ((clientX - rect.left) / rect.width) * 100;
				if (frameId) cancelAnimationFrame(frameId);
				frameId = requestAnimationFrame(() => {
					applyPosition(next);
					frameId = 0;
				});
			};

			stage.addEventListener('pointerdown', (event: PointerEvent) => {
				if (event.button !== 0 && event.pointerType === 'mouse') return;
				dragging = true;
				cachedRect = stage.getBoundingClientRect();
				slider.classList.add('is-dragging');
				stage.setPointerCapture(event.pointerId);
				updateFromClientX(event.clientX);
			});

			stage.addEventListener('pointermove', (event: PointerEvent) => {
				if (!dragging) return;
				updateFromClientX(event.clientX);
			});

			const endDrag = (event: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				cachedRect = null;
				slider.classList.remove('is-dragging');
				if (stage.hasPointerCapture(event.pointerId)) {
					stage.releasePointerCapture(event.pointerId);
				}
			};

			stage.addEventListener('pointerup', endDrag);
			stage.addEventListener('pointercancel', endDrag);

			handle.addEventListener('keydown', (event: KeyboardEvent) => {
				const step = event.shiftKey ? 15 : 5;
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					applyPosition(current - step);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					applyPosition(current + step);
				} else if (event.key === 'Home') {
					event.preventDefault();
					applyPosition(0);
				} else if (event.key === 'End') {
					event.preventDefault();
					applyPosition(100);
				}
			});

			applyPosition(current);
		});
	};

	initBeforeAfterSliders();
</script>
