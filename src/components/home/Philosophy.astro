---
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-astro';
import { PHILOSOPHY_DATA } from '../../data/studio';
---

<section class="philosophy" id="filosofia" aria-labelledby="philosophy-heading">
	<div class="container philosophy__inner">
		<header class="philosophy__header" data-reveal>
			<p class="editorial-label">{PHILOSOPHY_DATA.label}</p>
			<h2 class="philosophy__title" id="philosophy-heading">
				{PHILOSOPHY_DATA.headingStart}{' '}
				<em class="editorial-italic">{PHILOSOPHY_DATA.headingEmphasis}</em>
			</h2>
		</header>

		<div class="philosophy__media" data-reveal style="--reveal-delay: 110ms;">
			<Image
				src={PHILOSOPHY_DATA.image}
				alt={PHILOSOPHY_DATA.imageAlt}
				widths={[640, 1024, 1440]}
				sizes="(max-width: 768px) 100vw, 90vw"
				loading="lazy"
				class="philosophy__image"
			/>
		</div>

		<div class="philosophy__footer" data-reveal style="--reveal-delay: 160ms;">
			<div class="philosophy__accent" aria-hidden="true"></div>
			<div class="philosophy__copy">
				<p class="philosophy__body">{PHILOSOPHY_DATA.body}</p>
				<p class="philosophy__signature">{PHILOSOPHY_DATA.signature}</p>
				<a class="editorial-link philosophy__link" href="/manifiesto">
					<span>Leer el manifiesto</span>
					<ArrowUpRight size={14} stroke-width={1.35} aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.philosophy {
		background-color: var(--color-ivory);
		color: var(--color-charcoal);
		padding-block: clamp(5.5rem, 11vw, 11rem);
	}

	.philosophy__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(2.75rem, 5.5vw, 4.75rem);
	}

	.philosophy__header {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 58rem;
	}

	.philosophy__title {
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 1.65rem + 3.5vw, 5rem);
		font-weight: 300;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.philosophy__media {
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background-color: #e4dfd6;
	}

	.philosophy__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		transition: transform var(--duration-slow) var(--ease-editorial);
	}

	.philosophy__media:hover .philosophy__image {
		transform: scale(1.025);
	}

	.philosophy__footer {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.5rem 2rem;
		align-items: start;
	}

	.philosophy__accent {
		grid-column: 1 / 4;
		width: 100%;
		max-width: 7rem;
		height: 1px;
		background-color: var(--color-terracotta);
		margin-top: 0.75rem;
	}

	.philosophy__copy {
		grid-column: 6 / 12;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.philosophy__body {
		font-size: var(--text-lead);
		font-weight: 300;
		line-height: 1.72;
		color: var(--color-charcoal);
	}

	.philosophy__signature {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.55rem);
		color: var(--color-ink-muted);
	}

	@media (max-width: 900px) {
		.philosophy__footer {
			grid-template-columns: 1fr;
		}

		.philosophy__accent,
		.philosophy__copy {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 640px) {
		.philosophy__media {
			aspect-ratio: 4 / 3;
		}
	}
</style>
