---
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-astro';
import { ESSENCE_DATA } from '../../data/studio';
---

<section class="essence" id="estudio" aria-labelledby="essence-heading">
	<div class="container essence__grid">
		<div class="essence__header" data-reveal>
			<p class="editorial-label">{ESSENCE_DATA.label}</p>
			<h2 class="essence__title" id="essence-heading">
				{ESSENCE_DATA.headingStart}
				<br />
				<em class="editorial-italic">{ESSENCE_DATA.headingEmphasis}</em>
			</h2>
		</div>

		<div class="essence__body-col" data-reveal style="--reveal-delay: 120ms;">
			<p class="essence__lead">{ESSENCE_DATA.body}</p>
			<div class="essence__rule" aria-hidden="true"></div>
			<p class="essence__secondary">{ESSENCE_DATA.secondary}</p>
			<a class="editorial-link" href="/estudio">
				<span>Conocer el estudio</span>
				<ArrowUpRight size={14} stroke-width={1.35} aria-hidden="true" />
			</a>
		</div>

		<figure class="essence__figure" data-reveal style="--reveal-delay: 200ms;">
			<div class="essence__media">
				<Image
					src={ESSENCE_DATA.image}
					alt={ESSENCE_DATA.imageAlt}
					widths={[480, 760, 1080]}
					sizes="(max-width: 900px) 100vw, 38vw"
					loading="lazy"
					class="essence__image"
				/>
			</div>
			<figcaption class="essence__caption">{ESSENCE_DATA.imageCaption}</figcaption>
		</figure>
	</div>
</section>

<style>
	.essence {
		background-color: var(--color-ivory);
		color: var(--color-charcoal);
		padding-block: var(--section-pad);
	}

	.essence__grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 2.5vw, 2.5rem);
		align-items: start;
	}

	.essence__header {
		grid-column: 1 / 11;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.essence__title {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		font-weight: 300;
		line-height: 1.04;
		letter-spacing: -0.02em;
		max-width: 18ch;
	}

	.essence__body-col {
		grid-column: 2 / 7;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding-top: clamp(1rem, 4vw, 4.5rem);
	}

	.essence__lead {
		font-family: var(--font-serif);
		font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.95rem);
		font-weight: 400;
		line-height: 1.42;
		color: var(--color-charcoal);
	}

	.essence__rule {
		width: 3.5rem;
		height: 1px;
		background-color: var(--color-terracotta);
	}

	.essence__secondary {
		font-size: var(--text-sm);
		line-height: 1.75;
		color: var(--color-ink-muted);
		max-width: 44ch;
	}

	.essence__figure {
		grid-column: 8 / 13;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.essence__media {
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background-color: #e4dfd6;
	}

	.essence__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slow) var(--ease-editorial);
	}

	.essence__figure:hover .essence__image {
		transform: scale(1.03);
	}

	.essence__caption {
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	@media (max-width: 960px) {
		.essence__header {
			grid-column: 1 / -1;
		}

		.essence__body-col {
			grid-column: 1 / 7;
			padding-top: 0;
		}

		.essence__figure {
			grid-column: 7 / -1;
		}
	}

	@media (max-width: 720px) {
		.essence__grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.essence__header,
		.essence__body-col,
		.essence__figure {
			grid-column: 1 / -1;
		}

		.essence__media {
			aspect-ratio: 4 / 5;
		}
	}
</style>
