---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/home/Hero.astro';
import Essence from '../components/home/Essence.astro';
import Services from '../components/home/Services.astro';
import SelectedWorks from '../components/home/SelectedWorks.astro';
import TransformationsPreview from '../components/home/TransformationsPreview.astro';
import Philosophy from '../components/home/Philosophy.astro';
import Booking from '../components/home/Booking.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout>
	<Header theme="dark" />
	<main id="contenido-principal">
		<Hero />
		<Essence />
		<Services />
		<SelectedWorks />
		<TransformationsPreview />
		<Philosophy />
		<Booking />
	</main>
	<Footer />
</Layout>
